################################################################################
# Unified SGDC CDC Waiver File: system_waivers.swd
# Design: Final_System
################################################################################

# 1. Setup_port01: Primary Reset Port Coverage
waive -rule "Setup_port01" \
      -msg "*Port coverage for top design unit*Final_System*not fully constrained*" \
      -comment "Primary asynchronous reset port RST drives dedicated synchronizers (RST_SYNC)."

# 2. Clock_check04: Negedge Clock Usage in Divider
waive -rule "Clock_check04" \
      -msg "*Recommended edge*Final_System.UART_CLK*not used*" \
      -comment "Intentional usage of falling clock edge (negedge) for 50% duty cycle in odd clock divider."

# 3. Clock_converge01: UART_CLK Convergence on RX Clock
waive -rule "Clock_converge01" \
      -msg "*Clock*Final_System.UART_CLK*converges on*Final_System.CLK_RX*" \
      -comment "Intentional clock reconvergence via OR gate in odd divider architecture."

# 4. Clock_glitch04: Divider Logic Reconvergence on Destination Registers
waive -rule "Clock_glitch04" \
      -msg "*ClkDiv_TX.clk_div*ClkDiv_TX.clk_odd_div*converging*R_addr*" \
      -comment "Structural artifact of posedge/negedge OR gate in ClkDiv_TX for 50% duty cycle."

waive -rule "Clock_glitch04" \
      -msg "*ClkDiv_RX.clk_div*ClkDiv_RX.clk_odd_div*converging*current_state*" \
      -comment "Structural artifact of posedge/negedge OR gate in ClkDiv_RX for 50% duty cycle."

# 5. Ac_conv02: Combinational Convergence of Synchronized Pointers (Full & Empty)
waive -rule "Ac_conv02" \
      -msg "*DF_SYNC_R.MULTI_FLIP_FLOP*converge on combinational gate*Final_System.R_empty*" \
      -comment "Safe: Gray-coded pointers from DF_SYNC_R converge to evaluate FIFO R_empty."

waive -rule "Ac_conv02" \
      -msg "*DF_SYNC_W.MULTI_FLIP_FLOP*converge on combinational gate*Final_System.W_full*" \
      -comment "Safe: Gray-coded pointers from DF_SYNC_W converge to evaluate FIFO W_full."

# 6. Ac_conv04: FIFO Memory to UART_TX Serializer Payload Bus
waive -rule "Ac_conv04" \
      -msg "*source bus*FIFO_MEM_CNTRL.mem*destination bus*serializer.shift_register*" \
      -comment "Safe: FIFO read data payload bus is protected by R_empty handshaking, not requiring Gray encoding."

# Ac_conv01: Control Signals Convergence in System Controller FSM
waive -rule "Ac_conv01" \
      -msg "*synchronizers*DF_SYNC_W*MULTI_FLIP_FLOP*DATA_SYNC*MULTI_FLIP_FLOP*converge on MUX*SYS_CTRL.next_state*" \
      -comment "Safe: DATA_SYNC and FIFO DF_SYNC evaluate in mutually exclusive FSM states."

# 7. Ac_cdc01a: Fast-to-Slow Crossing for Gray Write Pointers
waive -rule "Ac_cdc01a" \
      -msg "*Final_System.ASYNC_FIFO.W_ptr*to*DF_SYNC_R.MULTI_FLIP_FLOP*" \
      -comment "Safe: FIFO write pointer Gray-coded crossing skips intermediate states safely without data loss."

# 8. Ac_datahold01a: Data-Enable Sequencing for FIFO Payload
waive -rule "Ac_datahold01a" \
      -msg "*destination flop*Parity_calc.Par_bit*source flop*FIFO_MEM_CNTRL.mem*" \
      -comment "Safe: FIFO read payload crossing to Parity_calc is structurally protected by FIFO read-empty handshaking."

waive -rule "Ac_datahold01a" \
      -msg "*destination flop*serializer.shift_register*source flop*FIFO_MEM_CNTRL.mem*" \
      -comment "Safe: FIFO read payload crossing to serializer shift register is structurally protected by FIFO read-empty handshaking."

# 9. Ac_clockperiod03: Asynchronous Clock Period Domain Ratio
waive -rule "Ac_clockperiod03" \
      -msg "*Design cycles for clocks*Final_System.UART_CLK,Final_System.REF_CLK*exceeds the threshold*" \
      -comment "Safe: REF_CLK and UART_CLK are asynchronous; decoupling is handled via FIFOs and synchronizers."
