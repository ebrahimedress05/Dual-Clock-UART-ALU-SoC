module data_sampling_test_1 ( RX_IN, prescale, edge_cnt, CLK, RST, dat_samp_en, 
        sampled_bit, test_si, test_so, test_se );
  input [5:0] prescale;
  input [5:0] edge_cnt;
  input RX_IN, CLK, RST, dat_samp_en, test_si, test_se;
  output sampled_bit, test_so;
  wire   bit_1, bit_2, bit_3, N6, N7, N8, N9, N10, N11, N12, N15, N16, N17,
         N18, N19, n26, n27, \add_28/carry[4] , \add_28/carry[3] ,
         \add_28/carry[2] , n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n14, n15,
         n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n28, n29, n30, n31,
         n32, n33, n34, n35, n36, n37, n38, n39;
  assign test_so = bit_3;

  SDFFRQX2M bit_3_reg ( .D(n39), .SI(bit_2), .SE(test_se), .CK(CLK), .RN(RST), 
        .Q(bit_3) );
  SDFFRQX2M bit_2_reg ( .D(n26), .SI(bit_1), .SE(test_se), .CK(CLK), .RN(RST), 
        .Q(bit_2) );
  SDFFRQX2M bit_1_reg ( .D(n27), .SI(test_si), .SE(test_se), .CK(CLK), .RN(RST), .Q(bit_1) );
  NOR4X2M U4 ( .A(n14), .B(n10), .C(n9), .D(n8), .Y(N12) );
  MXI2XLM U5 ( .A(n33), .B(n16), .S0(N12), .Y(n27) );
  NOR4XLM U6 ( .A(n18), .B(n19), .C(N12), .D(n20), .Y(n17) );
  OR2X2M U7 ( .A(prescale[2]), .B(prescale[1]), .Y(n1) );
  ADDHX1M U8 ( .A(prescale[4]), .B(\add_28/carry[3] ), .CO(\add_28/carry[4] ), 
        .S(N17) );
  ADDHX1M U11 ( .A(prescale[3]), .B(\add_28/carry[2] ), .CO(\add_28/carry[3] ), 
        .S(N16) );
  ADDHX1M U12 ( .A(prescale[2]), .B(prescale[1]), .CO(\add_28/carry[2] ), .S(
        N15) );
  ADDHX1M U13 ( .A(prescale[5]), .B(\add_28/carry[4] ), .CO(N19), .S(N18) );
  CLKINVX1M U14 ( .A(prescale[1]), .Y(N6) );
