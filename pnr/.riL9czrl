  OR2X1M U16 ( .A(n1), .B(prescale[3]), .Y(n2) );
  OAI2BB1X1M U17 ( .A0N(n1), .A1N(prescale[3]), .B0(n2), .Y(N8) );
  XNOR2X1M U18 ( .A(prescale[4]), .B(n2), .Y(N9) );
  NOR3X1M U19 ( .A(prescale[4]), .B(prescale[5]), .C(n2), .Y(N11) );
  OAI21X1M U20 ( .A0(prescale[4]), .A1(n2), .B0(prescale[5]), .Y(n3) );
  NAND2BX1M U21 ( .AN(N11), .B(n3), .Y(N10) );
  NOR2BX1M U22 ( .AN(edge_cnt[0]), .B(N6), .Y(n4) );
