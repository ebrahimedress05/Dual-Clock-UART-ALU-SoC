module Clk_Div_Mux ( prescale, Div_Ratio );
  input [5:0] prescale;
  output [7:0] Div_Ratio;
  wire   n5, n6, n7, n8, n9, n14, n15, n16, n17;

  OAI211X4M U11 ( .A0(n8), .A1(n9), .B0(n17), .C0(n16), .Y(Div_Ratio[0]) );
  NOR4X1M U12 ( .A(prescale[5]), .B(prescale[4]), .C(prescale[3]), .D(n15), 
        .Y(n8) );
  NAND2X2M U13 ( .A(n7), .B(n6), .Y(n9) );
  NAND4BX1M U14 ( .AN(prescale[3]), .B(prescale[4]), .C(n15), .D(n14), .Y(n7)
         );
  NAND4BX1M U15 ( .AN(prescale[4]), .B(prescale[3]), .C(n15), .D(n14), .Y(n6)
         );
  INVX2M U16 ( .A(prescale[2]), .Y(n15) );
  NOR3X4M U17 ( .A(n6), .B(prescale[1]), .C(prescale[0]), .Y(Div_Ratio[2]) );
  NOR3X4M U18 ( .A(n7), .B(prescale[1]), .C(prescale[0]), .Y(Div_Ratio[1]) );
  INVX2M U19 ( .A(prescale[1]), .Y(n16) );
  INVX2M U20 ( .A(prescale[0]), .Y(n17) );
  INVX2M U21 ( .A(prescale[5]), .Y(n14) );
  NOR4X2M U22 ( .A(n5), .B(prescale[3]), .C(prescale[5]), .D(prescale[4]), .Y(
        Div_Ratio[3]) );
  NAND3X2M U23 ( .A(n17), .B(n16), .C(prescale[2]), .Y(n5) );
  INVX2M U3 ( .A(1'b1), .Y(Div_Ratio[7]) );
  INVX2M U5 ( .A(1'b1), .Y(Div_Ratio[6]) );
  INVX2M U7 ( .A(1'b1), .Y(Div_Ratio[5]) );
  INVX2M U9 ( .A(1'b1), .Y(Div_Ratio[4]) );
endmodule


module Final_System_dft ( scan_CLK, scan_RST, test_mode, SE, SI, RX_IN, 
        REF_CLK, UART_CLK, RST, SO, TX_OUT, parity_error, stop_error );
  input [3:0] SI;
  output [3:0] SO;
  input scan_CLK, scan_RST, test_mode, SE, RX_IN, REF_CLK, UART_CLK, RST;
  output TX_OUT, parity_error, stop_error;
  wire   RST_M, SYNC_RST_1, scan_SYNC_RST_1, SYNC_RST_2, scan_SYNC_RST_2,
         scan_REF_CLK, scan_UART_CLK_pos, _0_net_, scan_UART_CLK_neg, CLK_TX,
         scan_CLK_TX, CLK_RX, scan_CLK_RX, data_valid_RX, SYNC_Valid,
         ALU_OUT_Valid, RdData_Valid, W_full, ALU_EN, CLK_EN, WrEn, RdEN,
         W_inc, CLK_ALU, R_inc, R_empty, Data_Valid_TX, Busy, n2, n3, n4, n5,
         n6, n10, n11, n12, n13, n35, n16, n17, n18, n19, n20, n24, n25, n26,
         n27, n28, n29, n30, n31, n32;
  wire   [7:0] REG2;
  wire   [7:0] P_DATA_RX;
  wire   [7:0] SYNC_P_DATA;
  wire   [15:0] ALU_OUT;
  wire   [7:0] RdData;
  wire   [3:0] ALU_FUN;
  wire   [3:0] Address;
  wire   [7:0] WrData;
  wire   [7:0] W_data;
  wire   [7:0] REG0;
  wire   [7:0] REG1;
  wire   [7:0] REG3;
  wire   [7:0] R_data;
  wire   [7:0] Div_Ratio_RX;
  wire   SYNOPSYS_UNCONNECTED__0, SYNOPSYS_UNCONNECTED__1, 
        SYNOPSYS_UNCONNECTED__2, SYNOPSYS_UNCONNECTED__3;

  INVX2M U2 ( .A(n6), .Y(n5) );
  INVX2M U3 ( .A(n4), .Y(n3) );
  BUFX2M U4 ( .A(test_mode), .Y(n2) );
  INVX2M U5 ( .A(scan_SYNC_RST_2), .Y(n4) );
  INVX2M U6 ( .A(scan_SYNC_RST_1), .Y(n6) );
  INVX2M U7 ( .A(scan_CLK), .Y(_0_net_) );
  DLY1X1M U13 ( .A(SE), .Y(n24) );
  DLY1X1M U14 ( .A(SE), .Y(n25) );
  DLY1X1M U15 ( .A(SE), .Y(n26) );
  DLY1X1M U16 ( .A(SE), .Y(n27) );
  DLY1X1M U17 ( .A(n32), .Y(n28) );
  DLY1X1M U18 ( .A(n32), .Y(n29) );
  DLY1X1M U19 ( .A(n32), .Y(n30) );
  DLY1X1M U20 ( .A(n32), .Y(n31) );
  DLY1X1M U21 ( .A(n25), .Y(n32) );
  CLKBUFX40M U22 ( .A(SO[1]), .Y(stop_error) );
  CLKBUFX40M U23 ( .A(n35), .Y(SO[2]) );
  MUX2x1_2 U0_MUX ( .IN_0(RST), .IN_1(scan_RST), .sel(n2), .OUT(RST_M) );
  MUX2x1_1 U1_MUX ( .IN_0(SYNC_RST_1), .IN_1(scan_RST), .sel(n2), .OUT(
        scan_SYNC_RST_1) );
  MUX2x1_7 U2_MUX ( .IN_0(SYNC_RST_2), .IN_1(scan_RST), .sel(n2), .OUT(
        scan_SYNC_RST_2) );
  MUX2x1_0 U3_MUX ( .IN_0(REF_CLK), .IN_1(scan_CLK), .sel(n2), .OUT(
        scan_REF_CLK) );
  MUX2x1_6 U4_MUX ( .IN_0(UART_CLK), .IN_1(scan_CLK), .sel(n2), .OUT(
        scan_UART_CLK_pos) );
  MUX2x1_5 U5_MUX ( .IN_0(UART_CLK), .IN_1(_0_net_), .sel(n2), .OUT(
        scan_UART_CLK_neg) );
  MUX2x1_4 U6_MUX ( .IN_0(CLK_TX), .IN_1(scan_CLK), .sel(n2), .OUT(scan_CLK_TX) );
  MUX2x1_3 U7_MUX ( .IN_0(CLK_RX), .IN_1(scan_CLK), .sel(n2), .OUT(scan_CLK_RX) );
  RST_SYNC_NUM_STAGES2_test_0 RST_SYNC_1 ( .RST(RST_M), .CLK(scan_REF_CLK), 
        .SYNC_RST(SYNC_RST_1), .test_si(R_inc), .test_so(n17), .test_se(n30)
         );
  RST_SYNC_NUM_STAGES2_test_1 RST_SYNC_2 ( .RST(RST_M), .CLK(scan_UART_CLK_pos), .SYNC_RST(SYNC_RST_2), .test_si(n17), .test_so(n16), .test_se(n29) );
  UART_RX_test_1 UART_RX ( .RX_IN(RX_IN), .prescale(REG2[7:2]), .PAR_EN(
        REG2[0]), .PAR_TYP(REG2[1]), .CLK(scan_CLK_RX), .RST(n3), .P_DATA(
        P_DATA_RX), .parity_error(parity_error), .stop_error(SO[1]), 
        .data_valid(data_valid_RX), .test_si2(n10), .test_si1(n13), .test_so1(
        n12), .test_se(n27) );
  DATA_SYNC_BUS_WIDTH8_NUM_STAGES2_test_1 DATA_SYNC ( .unsync_bus(P_DATA_RX), 
        .bus_enable(data_valid_RX), .CLK(scan_REF_CLK), .RST(n5), .sync_bus(
        SYNC_P_DATA), .enable_pulse(SYNC_Valid), .test_si(n18), .test_se(n24)
         );
  SYS_CTRL_OPER_WIDTH8_ALU_OUT_WIDTH16_Address_width4_test_1 SYS_CTRL ( 
        .ALU_OUT(ALU_OUT), .OUT_Valid(ALU_OUT_Valid), .RX_P_Data(SYNC_P_DATA), 
        .RX_D_VLD(SYNC_Valid), .RdData(RdData), .RdData_Valid(RdData_Valid), 
        .FIFO_FULL(W_full), .CLK(scan_REF_CLK), .RST(n5), .ALU_EN(ALU_EN), 
        .ALU_FUN(ALU_FUN), .CLK_EN(CLK_EN), .Address(Address), .WrEN(WrEn), 
        .RdEN(RdEN), .WrData(WrData), .TX_P_DATA(W_data), .TX_D_VLD(W_inc), 
        .test_si2(SI[1]), .test_si1(n16), .test_so2(n13), .test_so1(n35), 
        .test_se(n26) );
  regfile_Address_width4_Data_width8_depth16_test_1 regfile ( .WrData(WrData), 
        .Address(Address), .WrEn(WrEn), .RdEN(RdEN), .CLK(scan_REF_CLK), .RST(
        n5), .RdData(RdData), .RdData_Valid(RdData_Valid), .REG0(REG0), .REG1(
        REG1), .REG2(REG2), .REG3(REG3), .test_si2(SI[0]), .test_si1(n11), 
        .test_so2(SO[0]), .test_so1(n10), .test_se(n24) );
  ALU_OPER_WIDTH8_OUT_WIDTH16_test_1 ALU ( .A(REG0), .B(REG1), .EN(ALU_EN), 
        .ALU_FUN(ALU_FUN), .CLK(CLK_ALU), .RST(n5), .ALU_OUT(ALU_OUT), 
        .OUT_VALID(ALU_OUT_Valid), .test_si(SI[3]), .test_se(n28) );
  CLK_GATE_dft CLK_GATE ( .CLK_EN(CLK_EN), .TE(n2), .CLK(scan_REF_CLK), 
        .GATED_CLK(CLK_ALU) );
  ASYNC_FIFO_data_width8_depth8_addr_width4_NUM_STAGES2_test_1 ASYNC_FIFO ( 
        .W_data(W_data), .W_inc(W_inc), .R_inc(R_inc), .W_CLK(scan_REF_CLK), 
        .W_RST(n5), .R_CLK(scan_CLK_TX), .R_RST(n3), .R_data(R_data), .W_full(
        W_full), .R_empty(R_empty), .test_si2(SI[2]), .test_si1(ALU_OUT_Valid), 
        .test_so2(n20), .test_so1(SO[3]), .test_se(n25) );
  UART_TX_test_1 UART_TX ( .P_DATA(R_data), .Data_Valid(Data_Valid_TX), 
        .PAR_EN(REG2[0]), .PAR_TYP(REG2[1]), .CLK(scan_CLK_TX), .RST(n3), 
        .TX_OUT(TX_OUT), .Busy(Busy), .test_si(n12), .test_so(n11), .test_se(
        n26) );
  NOT NOT ( .X(R_empty), .Y(Data_Valid_TX) );
  PULSE_GEN_test_1 PULSE_GEN ( .LVL_SIG(Busy), .RST(n3), .CLK(scan_CLK_TX), 
        .PULSE_SIG(R_inc), .test_si(SYNC_P_DATA[7]), .test_se(n31) );
  ClkDiv_dft_test_0 ClkDiv_RX ( .i_ref_clk_pos(scan_UART_CLK_pos), 
        .i_ref_clk_neg(scan_UART_CLK_neg), .i_rst_n(n3), .i_clk_en(1'b1), 
        .i_div_ratio({1'b0, 1'b0, 1'b0, 1'b0, Div_Ratio_RX[3:0]}), .o_div_clk(
        CLK_RX), .test_si(n20), .test_so(n19), .test_se(n24) );
  ClkDiv_dft_test_1 ClkDiv_TX ( .i_ref_clk_pos(scan_UART_CLK_pos), 
        .i_ref_clk_neg(scan_UART_CLK_neg), .i_rst_n(n3), .i_clk_en(1'b1), 
        .i_div_ratio(REG3), .o_div_clk(CLK_TX), .test_si(n19), .test_so(n18), 
        .test_se(n27) );
  Clk_Div_Mux Clk_Div_Mux ( .prescale(REG2[7:2]), .Div_Ratio({
        SYNOPSYS_UNCONNECTED__0, SYNOPSYS_UNCONNECTED__1, 
        SYNOPSYS_UNCONNECTED__2, SYNOPSYS_UNCONNECTED__3, Div_Ratio_RX[3:0]})
         );
endmodule

