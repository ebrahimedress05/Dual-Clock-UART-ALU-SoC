  SDFFRQX2M \synchronizer_reg[0]  ( .D(\synchronizer[1] ), .SI(test_si), .SE(
        test_se), .CK(CLK), .RN(RST), .Q(SYNC_RST) );
  SDFFRQX2M \synchronizer_reg[1]  ( .D(1'b1), .SI(SYNC_RST), .SE(test_se), 
        .CK(CLK), .RN(RST), .Q(\synchronizer[1] ) );
endmodule


